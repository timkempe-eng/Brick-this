# Signing follows docs/DEV_SETUP.md from timkempe-eng/hydive: fastlane match,
# never Xcode automatic signing.
#
# Automatic signing tries to resolve the whole signing lifecycle — development
# profile as well as distribution — the moment xcodebuild has any valid Apple
# credentials. A from-scratch CI account can't satisfy the development side
# (no registered devices) and can't persist a keychain across ephemeral
# runners. match sidesteps the class: one distribution certificate and profile,
# created once, encrypted, stored on a branch, reused forever.

require "base64"

APP_ID       = "app.dad.Dad"
EXTENSION_IDS = [
  "app.dad.Dad.ShieldConfiguration",
  "app.dad.Dad.ShieldAction",
  "app.dad.Dad.ActivityMonitor",
  "app.dad.Dad.Widget",
].freeze
ALL_IDS = ([APP_ID] + EXTENSION_IDS).freeze

def require_env(name, how)
  value = ENV[name].to_s
  # A missing GitHub secret arrives as "", not nil, so ||= and ?? never fire.
  UI.user_error!("#{name} is not set. #{how}") if value.empty?
  value
end

def distribution_certificate_count(api_key:)
  Spaceship::ConnectAPI.token = api_key[:key] if api_key[:key]
  Spaceship::ConnectAPI::Certificate.all.count do |c|
    c.certificate_type.to_s.include?("DISTRIBUTION")
  end
rescue StandardError => e
  # Never block a release on a failed count — report and continue.
  UI.important("Could not count distribution certificates (#{e.class}). Continuing.")
  0
end

# owner/repo out of an https git url, with or without a trailing .git.
def repo_slug(git_url)
  m = git_url.to_s.match(%r{github\.com[/:]([^/]+)/([^/]+?)(?:\.git)?/?\z})
  m && "#{m[1]}/#{m[2]}"
end

def github_api(path, token)
  require "net/http"
  uri = URI("https://api.github.com#{path}")
  req = Net::HTTP::Get.new(uri)
  req["Authorization"] = "Bearer #{token}" unless token.to_s.empty?
  req["Accept"] = "application/vnd.github+json"
  res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |h| h.request(req) }
  return nil unless res.code == "200"
  require "json"
  JSON.parse(res.body)
rescue StandardError
  nil
end

# Does the storage repo already hold a match branch to reuse?
#
# This asks about the repo named by MATCH_GIT_URL, using MATCH_GIT_TOKEN.
# An earlier version asked about GITHUB_REPOSITORY with GITHUB_TOKEN, which
# is the wrong repo the moment storage lives anywhere else — it reported "no
# branch" for a store that did hold a certificate, and the cap guard below
# then refused a release that would have worked.
def match_branch_exists?(git_url:, token:)
  slug = repo_slug(git_url)
  return false if slug.nil?
  branch = ENV["MATCH_GIT_BRANCH"].to_s.empty? ? "match" : ENV["MATCH_GIT_BRANCH"]
  !github_api("/repos/#{slug}/branches/#{branch}", token).nil?
end

platform :ios do

  desc "Build and upload to TestFlight"
  lane :beta do |options|
    key_id    = require_env("ASC_KEY_ID", "App Store Connect → Users and Access → Integrations.")
    issuer_id = require_env("ASC_ISSUER_ID", "Same page, above the key list.")
    key_p8    = require_env("ASC_KEY_P8", "base64 of AuthKey_XXXX.p8 — it downloads once.")
    team_id   = require_env("APPLE_TEAM_ID", "Developer account → Membership, 10 characters.")

    unless key_p8.start_with?("LS0t")
      # base64 of "-----BEGIN" starts LS0t. Catch a raw .p8 paste here rather
      # than as an opaque signing failure twenty minutes in.
      UI.user_error!("ASC_KEY_P8 doesn't look base64-encoded. Store `base64 -i AuthKey_XXXX.p8`, not the raw file.")
    end

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_p8,
      is_key_content_base64: true,
    )

    # Where match's certificates live, and what may read them.
    #
    # match stores an ENCRYPTED distribution certificate and private key. The
    # store must be a PRIVATE repo. This repo is public — that is deliberate,
    # it is what makes the macOS runners free — so it can never be the store,
    # and the guard below enforces that rather than trusting a comment.
    #
    # GITHUB_TOKEN is scoped to THIS repository, so a store anywhere else needs
    # its own PAT. Catch that here: the alternative is a permission failure
    # twenty minutes into a signed build.
    this_repo = require_env("GITHUB_REPOSITORY", "Provided by Actions.")
    match_git_url = require_env(
      "MATCH_GIT_URL",
      "Repository variable naming a PRIVATE repo for match to store the " \
      "certificate in, e.g. https://github.com/#{this_repo.split('/').first}/dad-certificates. " \
      "It must not be this repo, which is public."
    )
    foreign_storage = !match_git_url.downcase.end_with?(this_repo.downcase)

    match_git_token = ENV["MATCH_GIT_TOKEN"].to_s
    if match_git_token.empty?
      if foreign_storage
        UI.user_error!(
          "MATCH_GIT_URL points at #{match_git_url}, which is not this repository, " \
          "but MATCH_GIT_TOKEN is not set. Actions' own GITHUB_TOKEN cannot read or " \
          "write another repo's match branch. Create a PAT with contents:read+write " \
          "on that repo and store it as the MATCH_GIT_TOKEN secret."
        )
      end
      match_git_token = require_env("GITHUB_TOKEN", "Provided by Actions.")
    end

    # A public store would publish the encrypted certificate to the world.
    # MATCH_PASSWORD is then the only thing between a reader and the ability to
    # sign as this team, which is not a position to be in by accident.
    storage = github_api("/repos/#{repo_slug(match_git_url)}", match_git_token)
    if storage && storage["private"] == false
      UI.user_error!(
        "MATCH_GIT_URL points at #{match_git_url}, which is PUBLIC. match would " \
        "commit this team's encrypted distribution certificate and private key " \
        "there for anyone to fetch. Point it at a private repo."
      )
    end
    UI.important("match storage: #{match_git_url} (#{storage ? 'reachable' : 'not readable with this token — the clone may fail'})")

    # Apple caps distribution certificates per account — commonly reported as
    # three for a standard account, two for enterprise, and not documented
    # precisely enough to bet a locked-out account on. Dad mints its own into
    # its own private store rather than sharing another app's, which spends a
    # slot. A run that creates one and dies before storing it strands that slot
    # permanently. So look before leaping, every time — it is one API call.
    # The threshold here is deliberately conservative.
    existing = distribution_certificate_count(api_key: api_key)
    UI.important("#{existing} distribution certificate(s) on this account.")
    if existing >= 2 && !match_branch_exists?(git_url: match_git_url, token: match_git_token)
      UI.user_error!(
        "This account already has #{existing} distribution certificates and no stored " \
        "match branch at #{match_git_url} to reuse, so match would try to mint one " \
        "toward Apple's ceiling. Run the 'Apple account maintenance' workflow to list " \
        "them and revoke a stranded one first."
      )
    end

    # match clones its storage branch OUTSIDE the checkout tree, so it does not
    # inherit the checkout's credentials — hand it the workflow's own token.
    match(
      type: "appstore",
      app_identifier: ALL_IDS,
      api_key: api_key,
      team_id: team_id,
      storage_mode: "git",
      # MATCH_GIT_URL is required and must be private; see the guard above.
      # Dad keeps its own store and its own certificate rather than sharing
      # another project's: a shared store means a `match nuke` or a revoked
      # cert in either project silently breaks releases in the other.
      git_url: match_git_url,
      git_branch: ENV["MATCH_GIT_BRANCH"].to_s.empty? ? "match" : ENV["MATCH_GIT_BRANCH"],
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{match_git_token}"),
      readonly: false,
      # match judges a profile valid by expiry and certificate, not by its
      # capability set, so it will happily reuse one that predates a capability
      # you just added. Force only on the run that changed capabilities.
      force: options[:force_profiles].to_s == "true",
    )

    # Never hardcode a profile name: if an earlier partial run took the default,
    # match silently auto-suffixes a timestamp. Read back what it produced.
    profiles = ALL_IDS.to_h do |id|
      name = ENV["sigh_#{id}_appstore_profile-name"].to_s
      UI.user_error!("match produced no profile name for #{id}.") if name.empty?
      [id, name]
    end
    UI.message("Profiles: #{profiles.inspect}")

    # XcodeGen builds the project, so manual signing is injected into the spec
    # rather than set in an Xcode UI nobody here can open. CODE_SIGN_ENTITLEMENTS
    # stays per-target: a global one forces the app's entitlements onto an
    # extension whose profile doesn't authorize them, and the export fails.
    sh("python3", "../scripts/apply_signing.py",
       team_id,
       *profiles.flat_map { |id, name| [id, name] })

    sh("xcodegen", "generate", "--spec", "../project.yml", "--project", "..")

    build_app(
      project: "../Dad.xcodeproj",
      scheme: "Dad",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: profiles,
      },
      output_directory: "../build",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"],
    )
  end

  desc "List and revoke distribution certificates. Apple caps them at about two."
  lane :certs do |options|
    api_key = app_store_connect_api_key(
      key_id: require_env("ASC_KEY_ID", "See the beta lane."),
      issuer_id: require_env("ASC_ISSUER_ID", "See the beta lane."),
      key_content: require_env("ASC_KEY_P8", "See the beta lane."),
      is_key_content_base64: true,
    )
    Spaceship::ConnectAPI.auth(**api_key.slice(:key_id, :issuer_id, :key)) rescue Spaceship::ConnectAPI.token = api_key

    certs = Spaceship::ConnectAPI::Certificate.all.select do |c|
      c.certificate_type.to_s.include?("DISTRIBUTION")
    end
    certs.each { |c| UI.important("#{c.id}  #{c.certificate_type}  expires #{c.expiration_date}  #{c.display_name}") }
    UI.important("#{certs.count} distribution certificate(s). Apple's ceiling is about two.")

    target = options[:revoke_id].to_s
    unless target.empty?
      cert = certs.find { |c| c.id == target }
      UI.user_error!("No distribution certificate with id #{target}.") if cert.nil?
      cert.delete!
      UI.success("Revoked #{target}. Delete the match branch too, or match will keep serving the orphaned profile.")
    end
  end
end
