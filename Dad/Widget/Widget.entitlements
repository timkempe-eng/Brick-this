<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group and nothing else. The widget reads the session; it never
	     touches Screen Time, so it carries no family-controls entitlement and
	     is not a fifth bundle id needing Apple's manual approval. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.dad.shared</string>
	</array>
</dict>
</plist>
