<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Requested from Apple per bundle ID. See docs/entitlements.md. -->
	<key>com.apple.developer.family-controls</key>
	<true/>

	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.dad.shared</string>
	</array>

	<!-- TAG only. App Store upload validation rejects NDEF here on any current
	     SDK ("NDEF is disallowed"), and it rejected run 38283698097 for it. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
